# ─── Required: Anthropic API Key ────────────────────────────────────
# Get yours at: https://console.anthropic.com/settings/keys
# Used for AI-powered job scoring and categorization.
# Cost: ~$0.05-0.20 per run (~$2-6/month)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ─── Required: Gmail Credentials ────────────────────────────────────
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication (if not already)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an App Password for "Mail" > "Other" > name it "JobBot"
# 5. Copy the 16-character password (spaces don't matter)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Required: Recipient Email ──────────────────────────────────────
RECIPIENT_EMAIL=harry.cammer@gmail.com
